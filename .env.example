# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
# Токен вашего бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш Telegram Chat ID, полученный у @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ==============================================================================
# ПАРАМЕТРЫ ТРЕКЕРА
# ==============================================================================
# Интервал между проверками расписания в секундах (по умолчанию 15)
CHECK_INTERVAL=15

# Фоновый режим: True — окно браузера скрыто, False — окно браузера отображается
HEADLESS=True

# Прикреплять скриншоты страницы расписания к сообщению в Telegram (True / False)
SEND_SCREENSHOT=True

# Воспроизводить звуковой сигнал на компьютере при появлении свободных мест (True / False)
SOUND_ALERT=True

# Опционально: путь к отдельному файлу маршрутов (например, routes.json)
ROUTES_FILE=routes.json
